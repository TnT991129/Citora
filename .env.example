# Copia este archivo como .env.local y pon los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Notificaciones push (opcional). Clave pública de scripts/generate-vapid-keys.mjs.
VITE_VAPID_PUBLIC_KEY=

# Monitoreo de errores (opcional). DSN de tu proyecto en sentry.io.
VITE_SENTRY_DSN=
